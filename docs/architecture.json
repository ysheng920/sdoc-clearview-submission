  "cards": [
    {
      "dot": "cyan",
      "title": "Transparency is the data path",
      "items": [
        "Every engine emits one Trace record",
        "The UI renders those records, not a second log",
        "Evidence offsets point back into the document"
      ]
    },
    {
      "dot": "emerald",
      "title": "Only two engines use a model",
      "items": [
        "Comparison and decision are pure rules",
        "Every verdict names the rule behind it",
        "88.8% of fields parsed without a model"
      ]
    },
    {
      "dot": "violet",
      "title": "Local first, cloud on doubt",
      "items": [
        "Three backends behind one protocol",
        "The mock needs no GPU and no API key",
        "The router scores the category tokens alone"
      ]
    },
    {
      "dot": "amber",
      "title": "The loop closes through a person",
      "items": [
        "Drafts are never sent by the system",
        "A correction becomes a naming standard",
        "And a regression case, not training data"
      ]
    }
  ]
