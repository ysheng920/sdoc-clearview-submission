# Copy to backend/.env. Production classification uses Jev first and falls
# back to Gemini below the configured confidence threshold.
LLM_BACKEND=operational

# Gemini API (LLM_BACKEND=gemini)
# Get free API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CLASSIFICATION_FALLBACK_THRESHOLD=0.80

# OpenRouter target (LLM_BACKEND=openrouter)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model for OpenRouter (Gemini defaults to gemini-2.0-flash).
MODEL=qwen/qwen3-vl-8b-instruct

# Cap on completion tokens per call. Below ~400 a reply can be cut off before
# it closes its JSON, which reads downstream as a parse failure.
MAX_TOKENS=400

# Concurrent emails. This is a hosted API now, not one local GPU, so it can go
# higher than the 2 that a single 8GB card needed.
WORKERS=4

# The Benchmark page can still run Jev, Gemini, and the OpenRouter MODEL
# independently. Those experiment choices do not change the production queue's
# Jev -> Gemini routing policy.
